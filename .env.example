# ==============================================================================
# FloraScheme Environment Configuration
# STRICT REQUIREMENT: Only MySQL database is supported!
# ==============================================================================

# Database Connection (MySQL Only)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=florascheme_db
MYSQL_CHARSET=utf8mb4

# Dynamic Schema Evolution (Automatically adds new scraper fields as MySQL columns)
AUTO_EVOLVE_SCHEMA=true

# Connection Pool Options
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=10

# Daily Scheduler Execution (24-hour HH:MM format, e.g. 02:00 for 2:00 AM)
DAILY_RUN_TIME=02:00
SCHEDULER_TIMEZONE=Asia/Kolkata

# Scrapers Configuration
GETFUND_ENABLED=true
GETFUND_WORKERS=10

MYSCHEME_ENABLED=true
MYSCHEME_WORKERS=5
MYSCHEME_LIMIT=0   # 0 = Scrape all available schemes; set to e.g. 10 for quick testing

# Local Backups (Save JSON/CSV snapshot alongside MySQL storage)
BACKUP_LOCAL_FILES=true
